# Read-only Postgres URL for ml_features_listings SELECT.
# Use a login role that has membership in propplus_price_trainer_readonly.
SUPABASE_DB_URL_READONLY=postgresql://...

# Service-role Postgres URL for model_runs INSERT
SUPABASE_DB_URL_SERVICE=postgresql://...

# R2 S3-compatible endpoint and credentials
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=propplus-ml-models
